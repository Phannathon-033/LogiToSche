# =====================================================================
# LogiAI Web Frontend Environment Configuration (.env)
# =====================================================================

# Optional: Set Gateway Base URL (Leave empty when using Vite proxy to http://localhost:8000)
VITE_API_BASE_URL=

# Gateway Security Token (Must match LOGIAI_GATEWAY_TOKEN in backend/.env)
# Leave empty for open development mode (no token required)
VITE_API_TOKEN=
