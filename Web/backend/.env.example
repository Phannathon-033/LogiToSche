# =====================================================================
# LogiAI Backend Environment Configuration (.env)
# =====================================================================

# Security Token for Gateway (Port 8000)
# If set, external clients must send header 'X-LogiAI-Token' matching this value.
# Leave empty to disable token requirement (open dev mode).
LOGIAI_GATEWAY_TOKEN=

# Model Execution Device ('gpu:0' or 'cuda:0' for NVIDIA GPU, 'cpu' for CPU mode)
LOGIAI_OCR_DEVICE=gpu:0
LOGIAI_SLM_DEVICE=cuda:0

# Dedicated SLM Service Endpoint URL (Internal port 8001)
LOGIAI_SLM_URL=http://127.0.0.1:8001
LOGIAI_OCR_ENDPOINT=http://127.0.0.1:8000/api/ocr
LOGIAI_SLM_ENDPOINT=http://127.0.0.1:8001/api/slm/extract

# Optional: Directory path overrides (System auto-discovers relative to Web/backend by default)
# LOGIAI_DATASET_DIR=../To_Testing
# LOGIAI_GROUND_TRUTH_PATH=ground_truth_dataset.json
# LOGIAI_REPORT_DIR=reports
# LOGIAI_OCR_CACHE_DIR=ocr_cache
# LOGIAI_PREDICTION_CACHE_DIR=prediction_cache
