# Windows server paths
LOGIAI_DATASET_DIR=C:\LogiToSche\To_Testing
LOGIAI_GROUND_TRUTH_PATH=C:\LogiToSche\Web\backend\ground_truth_dataset.json
LOGIAI_REPORT_DIR=C:\LogiToSche\Web\backend\reports
LOGIAI_OCR_CACHE_DIR=C:\LogiToSche\Web\backend\ocr_cache
LOGIAI_PREDICTION_CACHE_DIR=C:\LogiToSche\Web\backend\prediction_cache

# Local service endpoints
LOGIAI_OCR_ENDPOINT=http://127.0.0.1:8000/api/ocr
LOGIAI_SLM_ENDPOINT=http://127.0.0.1:8001/api/slm/extract
LOGIAI_SLM_URL=http://127.0.0.1:8001

# GPU devices
LOGIAI_OCR_DEVICE=gpu:0
LOGIAI_SLM_DEVICE=cuda:0

# Security Token for Gateway (Port 8000)
# If set, external clients must send header 'X-LogiAI-Token' matching this value.
# Use the same value in Web/.env as VITE_API_TOKEN.
LOGIAI_GATEWAY_TOKEN=replace-with-a-long-random-token
